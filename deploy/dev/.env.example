# Environment variables for dev docker-compose files.
# Copy to .env in this directory and fill in your values:
#   cp deploy/dev/.env.example deploy/dev/.env

# HuggingFace token — required for speaker diarization with whisperx engine.
# Obtain at https://huggingface.co/settings/tokens and accept the pyannote
# speaker-diarization model licence at https://huggingface.co/pyannote/speaker-diarization-3.1
HF_TOKEN=hf_your_token_here

# ASR service image. Defaults to asr-webservice:latest (mirrored from
# onerahmet/openai-whisper-asr-webservice:latest). Uncomment and set to a
# registry path if you mirror the image locally, e.g.
#   ASR_IMAGE=registry.example/asr-webservice:latest
# ASR_IMAGE=asr-webservice:latest

# Dev runs two ASR services (EPIC-054): asr-webservice on :9000, asr-webservice2 on :9001.
# ASR_MODEL  / ASR_ENGINE  configure the first  (defaults: tiny / whisperx)
# ASR_MODEL2 / ASR_ENGINE2 configure the second (defaults: v1_rnnt / gigaam)
# so the two transcripts differ and can be compared.
# ASR_REQUEST_LOGGING2 toggles request logging on the second service (default: true)
# ASR_MODEL=tiny
# ASR_ENGINE=whisperx
# ASR_MODEL2=v1_rnnt
# ASR_ENGINE2=gigaam
# ASR_REQUEST_LOGGING2=true
