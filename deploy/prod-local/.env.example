# prod-local environment variables — copy to .env and fill in real values.
# docker compose reads .env automatically when run from this directory.

# ASR service image. Defaults to asr-webservice:latest, which setup.sh loads
# from dist/whisper.tar (no network needed). If this host can reach an internal
# registry, point this at it instead and skip the tar — e.g.
#   ASR_IMAGE=registry.example/asr-webservice:latest
# ASR_IMAGE=asr-webservice:latest

# Whisper model size: tiny | base | small | medium | large
# Larger models are more accurate but slower and require more RAM/VRAM.
ASR_MODEL=small

# HuggingFace token — required for speaker diarization (whisperx + pyannote).
# Create a free token at https://huggingface.co/settings/tokens
# Accept the pyannote/speaker-diarization-3.1 model license before first use.
HF_TOKEN=

# UID/GID the whispercrawl container runs as (must match Dockerfile's appuser).
# setup.sh chowns audio/ and logs/ to this uid/gid so the container can write to them.
# Only change this if the image is rebuilt with a different uid.
APP_UID=1000
APP_GID=1000
