# Production environment variables — copy to .env and fill in real values.
# docker compose reads this file automatically when run from this directory.

# Base URL of the whisper-asr-webservice (no trailing slash)
ASR_WEBSERVICE_URL=http://192.168.1.10:9000

# Base URL of Ollama (no trailing slash)
OLLAMA_URL=http://192.168.1.11:11434

# UID/GID the whispercrawl container runs as (must match Dockerfile's appuser).
# setup.sh chowns audio/ and logs/ to this uid/gid so the container can write to them.
# Only change this if the image is rebuilt with a different uid.
APP_UID=1000
APP_GID=1000
